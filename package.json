{
  "name": "closeos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x || 26.x"
  },
  "scripts": {
    "dev": "tsx --env-file=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write server web tests scripts",
    "backup": "node --env-file=.env scripts/backup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.468.0",
    "luxon": "^3.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "railway": "^3.16.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
